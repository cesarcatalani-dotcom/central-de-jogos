      questions: [
        {
          q: "O que demonstra ter flexibilidade diante de um cenário ruim?",
          options: [
            { text: "Saber ajustar ou mudar de plano quando preciso.", correct: true },
            { text: "Insistir no mesmo erro mesmo vendo que deu errado.", correct: false }
          ]
        },
        {
          q: "O que fazer se o caminho planejado não funcionar na prática?",
          options: [
            { text: "Parar de tentar e nunca mais fazer projetos de vida.", correct: false },
            { text: "Reavaliar as opções e testar uma nova alternativa.", correct: true }
          ]
        },
        {
          q: "Por que a capacidade de adaptação é importante?",
          options: [
            { text: "Ajuda a superar imprevistos e continuar avançando.", correct: true },
            { text: "Impede que o estudante aprenda com novas vivências.", correct: false }
          ]
        }
      ]
    },
    {
      id: 12,
      text: "A colaboração em equipe nos ensina que grandes conquistas só acontecem quando unimos forças em torno de um objetivo comum.",
      questions: [
        {
          q: "O que a colaboração em equipe nos ensina sobre grandes conquistas?",
          options: [
            { text: "Que é melhor trabalhar isolado sem pedir nenhuma ajuda.", correct: false },
            { text: "Que elas exigem a união de forças por um objetivo comum.", correct: true }
          ]
        },
        {
          q: "Qual é o segredo para transformar ideias em ações reais de sucesso?",
          options: [
            { text: "Ignorar o planejamento e esperar o tempo passar sozinho.", correct: false },
            { text: "Unir esforços, ouvir opiniões e planejar em conjunto.", correct: true }
          ]
        },
        {
          q: "Como o aprendizado coletivo prepara os jovens para o futuro?",
          options: [
            { text: "Ensinando a conviver, dialogar e resolver problemas reais.", correct: true },
            { text: "Ensinando a não confiar em nenhuma pessoa na vida.", correct: false }
          ]
        }
      ]
    }
  ];

  const SIMULADO_QUESTIONS = [
    {
      id: 1,
      title: "Questão 1: Antes de tomar uma decisão importante para o seu futuro, como escolher um curso ou projeto, um estudante resolve imaginar três caminhos diferentes e pensar nos resultados de cada um. Esse ato de testar cenários antes de decidir serve para:",
      options: [
        "A) Copiar exatamente o caminho que outras pessoas decidiram seguir.",
        "B) Avaliar os riscos e as oportunidades de cada escolha com clareza.",
        "C) Garantir que ele nunca mais precise estudar ou trabalhar na vida.",
        "D) Fazer com que o estudante escolha a opção de forma irresponsável."
      ],
      correct: 1
    },
    {
      id: 2,
      title: "Questão 2: Na associação de moradores do bairro, as pessoas se reuniram para decidir o que fazer com uma praça abandonada. Em vez de uma pessoa mandar em tudo, cada morador deu sua ideia até encontrarem uma proposta boa para todos. Essa forma de agir demonstra a construção de:",
      options: [
        "A) Decisões autoritárias, onde apenas o líder mais forte tem voz.",
        "B) Conflitos intermináveis, que impedem a melhoria do espaço comum.",
        "C) Escolhas individuais, em que cada um cuida apenas da sua própria casa.",
        "D) Soluções coletivas, alcançadas por meio da conversa entre as pessoas."
      ],
      correct: 3
    },
    {
      id: 3,
      title: "Questão 3: Um estudante percebeu que precisava melhorar seu desempenho nas provas. Antes de mudar sua rotina, ele conversou com seus pais e professores para ouvir conselhos e organizou uma tabela de estudos com horários para cada matéria. Essa atitude demonstra que ele:",
      options: [
        "A) Analisou o papel das pessoas próximas e testou uma solução planejada.",
        "B) Agiu de forma impulsiva sem pensar nas consequências do futuro.",
        "C) Deixou de estudar por não conseguir decidir sozinho o que fazer.",
        "D) Ignorou a opinião da família e manteve os mesmos erros antigos."
      ],
      correct: 0
    },
    {
      id: 4,
      title: "Questão 4: Durante um trabalho em grupo na escola, dois colegas tinham ideias totalmente diferentes sobre como apresentar a maquete. Em vez de brigarem, a turma organizou uma roda de conversa onde cada um explicou seu ponto de vista até chegarem a um acordo. O elemento fundamental usado para resolver esse impasse foi:",
      options: [
        "A) A imposição da vontade do aluno com a voz mais alta.",
        "B) O diálogo respeitoso voltado para a construção coletiva.",
        "C) O cancelamento definitivo da apresentação da maquete.",
        "D) A escolha aleatória por sorteio de moedas sem debate."
      ],
      correct: 1
    },
    {
      id: 5,
      title: "Questão 5: Uma equipe de estudantes preparava um projeto de reciclagem para a feira de ciências. No meio do caminho, perceberam que o material escolhido era muito caro e não daria tempo de finalizar. Rapidamente, reuniram-se, reavaliaram o cenário e adaptaram o plano usando papelão descartado da escola. A capacidade demonstrada pelo grupo foi:",
      options: [
        "A) Falta de interesse com o resultado da feira de ciências.",
        "B) Flexibilidade para reavaliar escolhas e transformar o plano.",
        "C) Teimosia em manter um plano errado até o final da feira.",
        "D) Desistência do projeto por medo dos desafios práticos."
      ],
      correct: 1
    },
    {
      id: 6,
      title: "Questão 6: Ao planejar seus objetivos para os próximos anos, um jovem precisa levar em conta que suas ações individuais afetam os familiares, os amigos e a comunidade ao seu redor. Uma decisão orientada para um futuro consciente e responsável deve buscar:",
      options: [
        "A) Equilibrar os desejos pessoais com o bem-estar e o respeito ao coletivo.",
        "B) Priorizar apenas a vantagem própria sem se importar com os outros.",
        "C) Evitar qualquer tipo de plano pessoal para não incomodar ninguém.",
        "D) Transferir para a escola a responsabilidade de todas as suas escolhas."
      ],
      correct: 0
    }
  ];

  // --- VARIÁVEIS DE ESTADO ---
  let currentClueIndex = 0;
  let currentQuestionIndexInClue = 0;
  let collectedCluesCount = 0;
  let userAnswers = {};
  let isSpinning = false;
  let spinAngle = 0;

  // --- PARÂMETROS DE VELOCIDADE PROGRESSIVA ---
  let baseScrollSpeed = 3.5;
  let baseCarSpeed = 8;
  let scrollSpeed = 3.5;
  let carSpeed = 8;

  function updateDifficulty() {
    scrollSpeed = baseScrollSpeed + (collectedCluesCount * 0.75);
    carSpeed = baseCarSpeed + (collectedCluesCount * 0.8);
    
    const speedMultiplier = (1 + (collectedCluesCount * 0.2)).toFixed(1);
    document.getElementById('hud-speed').innerText = `${speedMultiplier}x`;
  }

  // --- NAVEGAÇÃO ---
  function showScreen(screenId) {
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    document.getElementById(screenId).classList.add('active');
  }

  // --- LÓGICA DA CANVAS ---
  const canvas = document.getElementById('game-canvas');
  const ctx = canvas.getContext('2d');

  let carX = 0;
  let carY = 0;
  let roadOffset = 0;
  let items = [];
  let isMovingLeft = false;
  let isMovingRight = false;
  let animationFrameId = null;

  function initCanvas() {
    canvas.width = canvas.parentElement.clientWidth;
    canvas.height = canvas.parentElement.clientHeight;
    carX = canvas.width / 2 - 15;
    carY = canvas.height - 90;
    updateDifficulty();
    spawnItems();
  }

  function spawnItems() {
    items = [];
    items.push({
      x: Math.random() * (canvas.width - 60) + 30,
      y: -100,
      type: 'green'
    });
    items.push({
      x: Math.random() * (canvas.width - 60) + 30,
      y: -320,
      type: 'red'
    });
  }

  function startGame() {
    showScreen('screen-game');
    initCanvas();
    if (!animationFrameId) {
      gameLoop();
    }
  }

  function gameLoop() {
    updateGame();
    drawGame();
    animationFrameId = requestAnimationFrame(gameLoop);
  }

  function updateGame() {
    if (isSpinning) {
      spinAngle += 0.35;
      if (spinAngle >= Math.PI * 6) {
        isSpinning = false;
        spinAngle = 0;
      }
      return;
    }

    if (isMovingLeft && carX > 20) carX -= carSpeed;
    if (isMovingRight && carX < canvas.width - 50) carX += carSpeed;

    roadOffset = (roadOffset + (scrollSpeed * 1.2)) % 40;

    for (let i = 0; i < items.length; i++) {
      let item = items[i];
      item.y += scrollSpeed;

      if (Math.abs(carX + 15 - item.x) < 25 && Math.abs(carY + 25 - item.y) < 25) {
        if (item.type === 'green') {
          item.y = -9999;
          triggerCheckpoint();
          break;
        } else if (item.type === 'red') {
          item.y = -9999;
          isSpinning = true;
          spinAngle = 0;
          break;
        }
      }

      if (item.y > canvas.height + 50) {
        item.y = -180 - Math.random() * 150;
        item.x = Math.random() * (canvas.width - 60) + 30;
      }
    }
  }

  function drawGame() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    ctx.fillStyle = '#1e1e1e';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    ctx.fillStyle = '#ffd700';
    ctx.fillRect(10, 0, 5, canvas.height);
    ctx.fillRect(canvas.width - 15, 0, 5, canvas.height);

    ctx.strokeStyle = '#555';
    ctx.lineWidth = 4;
    ctx.setLineDash([20, 20]);
    ctx.lineDashOffset = -roadOffset;
    ctx.beginPath();
    ctx.moveTo(canvas.width / 2, 0);
    ctx.lineTo(canvas.width / 2, canvas.height);
    ctx.stroke();
    ctx.setLineDash([]);

    items.forEach(item => {
      if (item.y < -500) return;
      ctx.save();
      if (item.type === 'green') {
        ctx.fillStyle = '#2ecc71';
        ctx.fillRect(item.x - 10, item.y - 12, 20, 24);
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(item.x - 7, item.y - 9, 14, 18);
        ctx.fillStyle = '#2ecc71';
        ctx.fillRect(item.x - 5, item.y - 6, 10, 3);
        ctx.fillRect(item.x - 5, item.y, 10, 3);
      } else {
        ctx.fillStyle = '#e74c3c';
        ctx.beginPath();
        ctx.arc(item.x, item.y, 12, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 14px sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('X', item.x, item.y);
      }
      ctx.restore();
    });

    ctx.save();
    ctx.translate(carX + 15, carY + 25);
    if (isSpinning) {
      ctx.rotate(spinAngle);
    }

    ctx.fillStyle = '#d4af37';
    ctx.fillRect(-15, -25, 30, 50);

    ctx.fillStyle = '#ffffff';
    ctx.fillRect(-12, -20, 5, 40);
    ctx.fillRect(-2, -20, 4, 40);
    ctx.fillRect(7, -20, 5, 40);

    ctx.fillStyle = '#000000';
    ctx.fillRect(-18, -20, 4, 10);
    ctx.fillRect(14, -20, 4, 10);
    ctx.fillRect(-18, 10, 4, 10);
    ctx.fillRect(14, 10, 4, 10);

    ctx.restore();
  }

  // Controles
  const btnLeft = document.getElementById('btn-left');
  const btnRight = document.getElementById('btn-right');

  btnLeft.addEventListener('touchstart', (e) => { e.preventDefault(); isMovingLeft = true; });
  btnLeft.addEventListener('touchend', (e) => { e.preventDefault(); isMovingLeft = false; });
  btnLeft.addEventListener('mousedown', () => isMovingLeft = true);
  btnLeft.addEventListener('mouseup', () => isMovingLeft = false);

  btnRight.addEventListener('touchstart', (e) => { e.preventDefault(); isMovingRight = true; });
  btnRight.addEventListener('touchend', (e) => { e.preventDefault(); isMovingRight = false; });
  btnRight.addEventListener('mousedown', () => isMovingRight = true);
  btnRight.addEventListener('mouseup', () => isMovingRight = false);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') isMovingLeft = true;
    if (e.key === 'ArrowRight') isMovingRight = true;
  });

  window.addEventListener('keyup', (e) => {
    if (e.key === 'ArrowLeft') isMovingLeft = false;
    if (e.key === 'ArrowRight') isMovingRight = false;
  });

  // --- CHECKPOINT DE 1 ÚNICA DICA ---
  function triggerCheckpoint() {
    const clueData = CLUES_DATA[currentClueIndex];
    // Sorteia uma das 3 perguntas da dica atual
    currentQuestionIndexInClue = Math.floor(Math.random() * clueData.questions.length);
    const qObj = clueData.questions[currentQuestionIndexInClue];

    document.getElementById('modal-clue-title').innerText = `DICA ${currentClueIndex + 1} DE 12`;
    document.getElementById('modal-clue-text').innerText = clueData.text;
    document.getElementById('modal-q-title').innerText = qObj.q;

    const optionsContainer = document.getElementById('modal-options');
    optionsContainer.innerHTML = '';

    qObj.options.forEach((opt) => {
      const btn = document.createElement('button');
      btn.className = 'option-btn';
      btn.innerText = opt.text;
      btn.onclick = () => answerCheckpoint(opt.correct);
      optionsContainer.appendChild(btn);
    });

    document.getElementById('modal-question-box').style.display = 'block';
    document.getElementById('modal-continue-btn').style.display = 'none';
    document.getElementById('game-modal').style.display = 'flex';
  }

  function answerCheckpoint(isCorrect) {
    if (isCorrect) {
      collectedCluesCount++;
      currentClueIndex++;
      document.getElementById('hud-clues').innerText = collectedCluesCount;
      updateDifficulty();

      if (collectedCluesCount >= 12) {
        document.getElementById('game-modal').style.display = 'none';
        showScreen('screen-game-end');
        return;
      }

      document.getElementById('modal-clue-title').innerText = "RESPOSTA CORRETA! ⚡";
      document.getElementById('modal-clue-text').innerText = `Muito bem! A velocidade aumentou para ${ (1 + (collectedCluesCount * 0.2)).toFixed(1) }x! Prepare-se para acelerar ainda mais!`;
      document.getElementById('modal-question-box').style.display = 'none';
      document.getElementById('modal-continue-btn').style.display = 'block';
    } else {
      document.getElementById('modal-clue-title').innerText = "OPS! RESPOSTA INCORRETA";
      document.getElementById('modal-clue-text').innerText = "Não tem problema! Tente prestar atenção para a próxima leitura!";
      document.getElementById('modal-question-box').style.display = 'none';
      document.getElementById('modal-continue-btn').style.display = 'block';
    }
  }

  function closeModal() {
    document.getElementById('game-modal').style.display = 'none';
    spawnItems();
  }

  // --- SIMULADO ---
  function renderSimulado() {
    const container = document.getElementById('simulado-container');
    container.innerHTML = '';

    SIMULADO_QUESTIONS.forEach((q) => {
      const qDiv = document.createElement('div');
      qDiv.className = 'quiz-question';

      let optionsHTML = '';
      q.options.forEach((opt, oIdx) => {
        optionsHTML += `
          <label class="quiz-option">
            <input type="radio" name="q_${q.id}" value="${oIdx}">
            <span>${opt}</span>
          </label>
        `;
      });

      qDiv.innerHTML = `
        <div class="quiz-q-title">${q.title}</div>
        <div>${optionsHTML}</div>
        <div class="teacher-help">
          Não entendeu? Procure o professor.
        </div>
      `;
      container.appendChild(qDiv);
    });
  }

  function finishSimulado() {
    userAnswers = {};
    let allAnswered = true;

    SIMULADO_QUESTIONS.forEach(q => {
      const selected = document.querySelector(`input[name="q_${q.id}"]:checked`);
      if (selected) {
        userAnswers[q.id] = parseInt(selected.value);
      } else {
        allAnswered = false;
      }
    });

    if (!allAnswered) {
      alert("Por favor, responda a todas as 6 perguntas antes de finalizar!");
      return;
    }

    renderGabarito();
    showScreen('screen-gabarito');
  }

  // --- GABARITO ---
  function renderGabarito() {
    const container = document.getElementById('gabarito-container');
    container.innerHTML = '';

    SIMULADO_QUESTIONS.forEach(q => {
      const userAns = userAnswers[q.id];
      const isCorrect = userAns === q.correct;

      const itemDiv = document.createElement('div');
      itemDiv.className = `result-item ${isCorrect ? 'correct' : ''}`;

      if (isCorrect) {
        itemDiv.innerHTML = `
          <div class="result-status status-correct">✓ ${q.title}</div>
          <div style="font-weight: bold; color: #2ecc71;">Acertou!</div>
        `;
      } else {
        itemDiv.innerHTML = `
          <div class="result-status status-wrong">✕ ${q.title}</div>
          <div class="ans-detail ans-user"><strong>Sua resposta:</strong> ${q.options[userAns]}</div>
          <div class="ans-detail ans-correct"><strong>Resposta correta:</strong> ${q.options[q.correct]}</div>
        `;
      }

      container.appendChild(itemDiv);
    });
  }

  function resetAll() {
    currentClueIndex = 0;
    collectedCluesCount = 0;
    userAnswers = {};
    document.getElementById('hud-clues').innerText = '0';
    updateDifficulty();
    showScreen('screen-learning');
  }

  renderSimulado();
</script>
